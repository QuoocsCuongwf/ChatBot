# ============================================================================
# ENVIRONMENT VARIABLES - Complete Pipeline
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (only commit .env.example)

# ============================================================================
# OpenAI API (for LLM Normalization - Step 4)
# ============================================================================
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Change model
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# Alternative LLM Providers (Optional)
# ============================================================================
# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_DEPLOYMENT=gpt-4

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini
# GOOGLE_API_KEY=your-google-api-key-here

# Local LLM (Ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

# ============================================================================
# Tesseract OCR Configuration
# ============================================================================
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# ============================================================================
# Poppler Configuration (for PDF to Image)
# ============================================================================
POPPLER_PATH=D:\apps\Poppler\poppler-25.12.0\Library\bin

# ============================================================================
# Pipeline Configuration
# ============================================================================
# Default DPI for OCR
OCR_DPI=400

# Embedding model (phobert, bge-m3, vina)
EMBEDDING_MODEL=phobert

# Vector DB (faiss, milvus, qdrant)
VECTOR_DB=faiss

# Output directory
OUTPUT_DIR=output_pipeline_complete

# ============================================================================
# Optional: HuggingFace Token (for private models)
# ============================================================================
# HUGGINGFACE_TOKEN=hf_your-token-here

# ============================================================================
# Optional: Logging and Monitoring
# ============================================================================
# LOG_LEVEL=INFO
# ENABLE_PROGRESS_BAR=true
